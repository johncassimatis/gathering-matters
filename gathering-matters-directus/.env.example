SECRET=replace-with-a-long-random-secret
PUBLIC_URL=http://localhost:8055

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

DB_CLIENT=pg
DB_HOST=your-personal-neon-direct-host.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USER=gm_directus
DB_PASSWORD=replace-with-the-gm-directus-password
DB_SSL=true

GM_RISK_HASH_SECRET=replace-with-a-long-random-risk-hash-secret
GM_SEARCH_CURSOR_SECRET=replace-with-a-long-random-search-cursor-secret
GM_TEST_MODE=false

# Test-runner-only settings. Keep these separate from the Directus DB role.
API_URL=http://localhost:8055
TEST_DB_HOST=your-test-database-host.neon.tech
TEST_DB_PORT=5432
TEST_DB_NAME=neondb
TEST_DB_USER=gm_test_runner
TEST_DB_PASSWORD=replace-with-the-gm-test-runner-password
TEST_DB_SSL=true

LICENSE_KEY=

# --- Public document attachments (Option A scan-gating; Increment 3) ---
# All OFF by default. The intake accepts documents only (PDF/DOCX/PPTX/XLSX/TXT);
# images, CSV, ODF, legacy/macro Office, archives, executables, scripts, HTML
# are rejected. Uploaded files land in the "Pending Malware Scan" folder (no role
# can read it) and are recorded PENDING until the scan consumer clears them.
GM_PUBLIC_FILE_UPLOADS_ENABLED=false
GM_PUBLIC_UPLOAD_MAX_FILES=5
GM_PUBLIC_UPLOAD_MAX_BYTES=15728640
GM_PUBLIC_UPLOAD_MAX_TOTAL_BYTES=52428800
# directus_folders UUID of "Pending Malware Scan" (from provision-scan-file-permissions.mjs
# output). Required only when GM_PUBLIC_FILE_UPLOADS_ENABLED=true. Do not hardcode in code.
GM_PENDING_FOLDER_ID=
