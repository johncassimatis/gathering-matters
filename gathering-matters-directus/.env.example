# Directus runtime configuration. Copy to .env (git-ignored) and fill in.
# NEVER commit .env. Directus 12 uses SECRET only — there is no KEY variable.

SECRET=replace-with-a-long-random-secret
PUBLIC_URL=http://localhost:8055

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

DB_CLIENT=pg
DB_HOST=your-personal-neon-direct-host.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USER=gm_directus
DB_PASSWORD=replace-with-the-gm-directus-password
DB_SSL=true

# Fail loudly if an extension does not load, instead of starting half-broken.
EXTENSIONS_MUST_LOAD=true

# --- CORS ---
# Every browser origin that calls this API, comma-separated: the Framer plugin
# CDN origin + the published site origin + the Framer preview origin. The public
# submission forms are CORS-blocked until the published site origin is listed
# here. Never use '*'.
CORS_ENABLED=true
CORS_ORIGIN=https://your-plugin-id.plugins.framercdn.com,https://your-published-site-origin

# --- Custom extension secrets (required before the endpoints work) ---
GM_RISK_HASH_SECRET=replace-with-a-long-random-risk-hash-secret
GM_SEARCH_CURSOR_SECRET=replace-with-a-long-random-search-cursor-secret

# --- Consent notice versions (stamped onto every stored consent record) ---
# Each defaults to 'v1' if unset; GM_CONTACT_ and GM_UPDATES_ fall back to
# GM_SUBMISSION_CONSENT_VERSION. Set them deliberately — these values are the
# durable record of which notice text a submitter actually agreed to.
GM_SUBMISSION_CONSENT_VERSION=v1
GM_CONTACT_CONSENT_VERSION=v1
GM_UPDATES_CONSENT_VERSION=v1

# Comma-separated Directus role ids allowed to run the promote-submission
# operation. Admins always pass. Leave empty until the role matrix exists —
# the operation safely refuses (403) for every non-admin while unset.
GM_PROMOTION_ROLE_IDS=

# Tags risk_event rows with the x-gm-test-run-id header so the API suite can
# clean up after itself. MUST be true on any instance under test, or the
# suite's rate-limit rows survive cleanup and fail the next run within the
# hour. Keep false in production.
GM_TEST_MODE=false

# Test-runner-only settings. Keep these separate from the Directus DB role.
API_URL=http://localhost:8055
TEST_DB_HOST=your-test-database-host.neon.tech
TEST_DB_PORT=5432
TEST_DB_NAME=neondb
TEST_DB_USER=gm_test_runner
TEST_DB_PASSWORD=replace-with-the-gm-test-runner-password
TEST_DB_SSL=true

LICENSE_KEY=

# --- Storage backend ---
# Default 'local' keeps uploads on the container volume (./uploads). The
# attachment/scan features below read objects directly, so they require an S3
# location: set STORAGE_LOCATIONS=s3 and fill the STORAGE_S3_* block. These are
# the same credentials the scan consumer reuses for SQS access.
STORAGE_LOCATIONS=local
STORAGE_LOCAL_ROOT=/directus/uploads
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-west-2
STORAGE_S3_ROOT=
# Endpoint + path-style are only needed for S3-compatible backends (MinIO in the
# integration tests). Leave both unset for real AWS S3.
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false

# --- Public document attachments (Option A scan-gating; Increment 3) ---
# All OFF by default. The intake accepts documents only (PDF/DOCX/PPTX/XLSX/TXT);
# images, CSV, ODF, legacy/macro Office, archives, executables, scripts, HTML
# are rejected. Uploaded files land in the "Pending Malware Scan" folder (no role
# can read it) and are recorded PENDING until the scan consumer clears them.
GM_PUBLIC_FILE_UPLOADS_ENABLED=false
GM_PUBLIC_UPLOAD_MAX_FILES=5
GM_PUBLIC_UPLOAD_MAX_BYTES=15728640
GM_PUBLIC_UPLOAD_MAX_TOTAL_BYTES=52428800
# directus_folders UUID of "Pending Malware Scan" (from provision-scan-file-permissions.mjs
# output). Required only when GM_PUBLIC_FILE_UPLOADS_ENABLED=true. Do not hardcode in code.
GM_PENDING_FOLDER_ID=

# --- GuardDuty scan-result consumer (Option A; Increment 4) ---
# OFF by default; when true, a scheduled Directus hook polls the SQS scan-result
# queue and moves clean files from "Pending Malware Scan" to "Clean Staff Review"
# only (never to Public Downloads). Reuses STORAGE_S3_KEY/SECRET for SQS access.
GM_SCAN_CONSUMER_ENABLED=false
GM_GUARDDUTY_SCAN_QUEUE_URL=
GM_CLEAN_REVIEW_FOLDER_ID=
GM_SCAN_EXPECTED_ACCOUNT=
# Region for the SQS client. Falls back to STORAGE_S3_REGION, then to a
# hardcoded 'us-west-2' — set one of the two explicitly.
GM_SCAN_AWS_REGION=us-west-2
GM_SCAN_CONSUMER_CRON=*/1 * * * *
GM_SCAN_CONSUMER_VISIBILITY_TIMEOUT=90
GM_SCAN_MAX_RECEIVE_COUNT=5
GM_SCAN_MAX_UNMATCHED_AGE_MS=900000

# --- Editorial/API scan gating (Option A; Increment 5) ---
# OFF by default. When true: gm-library returns a downloadable file only when
# clean + published + is_download; gm-publish-gate moves files between folders as
# publication/download-approval change (Public Downloads only when all conditions
# hold; revoked immediately when removed). Existing files unaffected when OFF.
GM_SCAN_GATING_ENABLED=false
GM_PUBLIC_DOWNLOADS_FOLDER_ID=
GM_PUBLIC_DOWNLOAD_REQUIRE_VERSION=true
GM_PUBLIC_DOWNLOAD_REQUIRE_ETAG=true

# --- Authenticated reviewer metadata (fail closed until role IDs are set) ---
GM_REVIEW_ROLE_IDS=
GM_REVIEW_DOWNLOAD_ROLE_IDS=
