SECRET=replace-with-a-long-random-secret
PUBLIC_URL=http://localhost:8055

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

DB_CLIENT=pg
DB_HOST=your-personal-neon-direct-host.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USER=gm_directus
DB_PASSWORD=replace-with-the-gm-directus-password
DB_SSL=true

GM_RISK_HASH_SECRET=replace-with-a-long-random-risk-hash-secret
GM_SEARCH_CURSOR_SECRET=replace-with-a-long-random-search-cursor-secret
GM_TEST_MODE=false

# Test-runner-only settings. Keep these separate from the Directus DB role.
API_URL=http://localhost:8055
TEST_DB_HOST=your-test-database-host.neon.tech
TEST_DB_PORT=5432
TEST_DB_NAME=neondb
TEST_DB_USER=gm_test_runner
TEST_DB_PASSWORD=replace-with-the-gm-test-runner-password
TEST_DB_SSL=true

LICENSE_KEY=

# --- Public document attachments (Option A scan-gating; Increment 3) ---
# All OFF by default. The intake accepts documents only (PDF/DOCX/PPTX/XLSX/TXT);
# images, CSV, ODF, legacy/macro Office, archives, executables, scripts, HTML
# are rejected. Uploaded files land in the "Pending Malware Scan" folder (no role
# can read it) and are recorded PENDING until the scan consumer clears them.
GM_PUBLIC_FILE_UPLOADS_ENABLED=false
GM_PUBLIC_UPLOAD_MAX_FILES=5
GM_PUBLIC_UPLOAD_MAX_BYTES=15728640
GM_PUBLIC_UPLOAD_MAX_TOTAL_BYTES=52428800
# directus_folders UUID of "Pending Malware Scan" (from provision-scan-file-permissions.mjs
# output). Required only when GM_PUBLIC_FILE_UPLOADS_ENABLED=true. Do not hardcode in code.
GM_PENDING_FOLDER_ID=

# --- GuardDuty scan-result consumer (Option A; Increment 4) ---
# OFF by default; when true, a scheduled Directus hook polls the SQS scan-result
# queue and moves clean files from "Pending Malware Scan" to "Clean Staff Review"
# only (never to Public Downloads). Reuses STORAGE_S3_KEY/SECRET for SQS access.
GM_SCAN_CONSUMER_ENABLED=false
GM_GUARDDUTY_SCAN_QUEUE_URL=
GM_CLEAN_REVIEW_FOLDER_ID=
GM_SCAN_EXPECTED_ACCOUNT=
GM_SCAN_CONSUMER_CRON=*/1 * * * *
GM_SCAN_CONSUMER_VISIBILITY_TIMEOUT=90
GM_SCAN_MAX_RECEIVE_COUNT=5
GM_SCAN_MAX_UNMATCHED_AGE_MS=900000

# --- Editorial/API scan gating (Option A; Increment 5) ---
# OFF by default. When true: gm-library returns a downloadable file only when
# clean + published + is_download; gm-publish-gate moves files between folders as
# publication/download-approval change (Public Downloads only when all conditions
# hold; revoked immediately when removed). Existing files unaffected when OFF.
GM_SCAN_GATING_ENABLED=false
GM_PUBLIC_DOWNLOADS_FOLDER_ID=
GM_PUBLIC_DOWNLOAD_REQUIRE_VERSION=true

# --- Authenticated reviewer metadata (fail closed until role IDs are set) ---
GM_REVIEW_ROLE_IDS=
GM_REVIEW_DOWNLOAD_ROLE_IDS=

# --- Authenticated staff-managed scan upload (POST /gm-intake/staff-files) ---
# OFF by default. When true, an authenticated administrator or an allowlisted
# role may upload exactly ONE supported document (PDF/DOCX/PPTX/XLSX/TXT) into the
# "Pending Malware Scan" folder; it is recorded PENDING with origin=STAFF_MANAGED
# so the scan consumer can correlate GuardDuty's event by the exact S3 object key.
# Never anonymous; never the public intake path. Requires GM_PENDING_FOLDER_ID.
# Used for the controlled production clean-file GuardDuty test; keep OFF otherwise.
GM_STAFF_FILE_UPLOADS_ENABLED=false
# Comma-separated Directus role UUIDs allowed to use the staff route (in addition
# to administrators). Empty = admins only. Fail-closed.
GM_STAFF_FILE_UPLOAD_ROLE_IDS=
