# gm-tag-sync configuration. Copy to .env (git-ignored) OR export these in your shell / Render env.
# NEVER commit real secrets.

# Directus (READ-ONLY). Use the Framer Sync read-only static token (extended to read tag + content_item_tag).
DIRECTUS_URL=https://cms.gatheringmatters.com
DIRECTUS_TOKEN=<framer-sync read-only static token>

# Framer Server API (project-scoped, write-capable). Create in Framer Site Settings -> General -> API.
FRAMER_PROJECT=https://framer.com/projects/Gathering-Matters--PlIAjWQAo3FC8MTsZjN0-aki1R
FRAMER_API_KEY=<framer server api key>
# Optional local convenience instead of FRAMER_API_KEY: a file path holding the key
# FRAMER_KEY_FILE=/path/to/framer_api.txt

# Name of the plugin-synced content collection in Framer (default: Directus)
CONTENT_COLLECTION=Directus
