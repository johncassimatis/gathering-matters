# Copy this file to flyway.user.toml and fill in your personal Neon branch:
#
#     cp flyway.user.toml.example flyway.user.toml
#
# flyway.user.toml is git ignored and must never be committed. It holds only
# your local connection details. The SET ROLE behaviour is already in
# flyway.toml.
#
# Bare Flyway commands default to this personal environment. Production is an
# explicit environment in flyway.toml and should only be targeted deliberately
# with -environment=production and separately managed credentials.

[environments.personal]
url = "jdbc:postgresql://YOUR_PERSONAL_BRANCH_HOST.neon.tech/neondb?sslmode=require&channel_binding=require"
user = "your_dev_login"
password = "your_dev_password"
