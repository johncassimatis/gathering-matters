# Copy this file to flyway.user.toml and fill in your own Neon credentials:
#
#     cp flyway.user.toml.example flyway.user.toml
#
# flyway.user.toml is git ignored and must never be committed. It holds only
# your personal login. The shared host and the SET ROLE behaviour are already
# in flyway.toml, so this file only needs your user and password.
#
# Use your own developer login (for example aaron_dev).

[environments.development]
user = "aaron_dev"
password = 'Y8":8SLx\l5C1C'

# Personal Neon branch for testing migrations before you merge them.
# Create a branch off dev in the Neon console, then copy its connection details
# here. The host differs from shared dev; the login is the same role, copied
# onto the branch. Uncomment and fill in when you set it up.
# See the README, "Testing on your personal Neon branch".
#
# [environments.personal]
# url = postgresql://ep-bold-bread-afuwwq8t.c-2.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# user = "aaron_dev"
# password = 'Y8":8SLx\l5C1C'
